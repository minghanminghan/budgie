# deploy/setup.sh copies this to /etc/budgie/budgie.env on the mini PC; fill it in there.
# Paths (DATABASE_URL, BACKUP_DIR, HF_HOME, TZ) live in /etc/budgie/paths.env, not here.
# Values with a "$" must be in single quotes.

# The page's URL: tailnet only, served by Caddy
BASE_URL=https://budgie.andrewminghanjiang.com

# Output of: uv run newsletter hash-password  (on your laptop; keep the single quotes)
APP_PASSWORD_HASH='scrypt$REPLACE_ME$REPLACE_ME'

# Random secrets: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=REPLACE_ME
LINK_SIGNING_SECRET=REPLACE_ME
API_TOKEN=REPLACE_ME

# Resend (sending domain already set up)
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Newsletter <newsletter@your-domain.com>
EMAIL_TO=you@your-domain.com
