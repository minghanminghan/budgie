# Copy to .env and fill in. Values with a "$" must be in single quotes.

# Public URL of the page: the node's Funnel name, https://newsletter.<tailnet>.ts.net
BASE_URL=https://newsletter.example-tailnet.ts.net

# Tailscale auth key for the sidecar (Admin console > Settings > Keys)
TS_AUTHKEY=tskey-auth-REPLACE_ME

# Output of: docker compose run --rm web newsletter hash-password  (keep the single quotes)
APP_PASSWORD_HASH='scrypt$REPLACE_ME$REPLACE_ME'

# Random secrets: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=REPLACE_ME
LINK_SIGNING_SECRET=REPLACE_ME
API_TOKEN=REPLACE_ME

# Resend (sending domain already set up)
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=Newsletter <newsletter@your-domain.com>
EMAIL_TO=you@your-domain.com

TZ=America/New_York
DATABASE_URL=sqlite:////data/newsletter.sqlite
